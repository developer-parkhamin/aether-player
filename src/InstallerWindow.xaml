<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AETHER Player 설치 프로그램"
    Width="840"
    Height="540"
    WindowStyle="None"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Background="#07090F"
    Foreground="#F4F7FB"
    FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.BitmapScalingMode="HighQuality">

  <Window.Resources>
    <SolidColorBrush x:Key="CyanAccent" Color="#38BDF8" />
    <SolidColorBrush x:Key="IceAccent" Color="#22D3EE" />
    <SolidColorBrush x:Key="SurfaceDark" Color="#0E1320" />
    <SolidColorBrush x:Key="SurfaceCard" Color="#111827" />
    <SolidColorBrush x:Key="BorderHairline" Color="#1E293B" />
    <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextDim" Color="#64748B" />

    <!-- Primary Glowing Cyan Button -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="22,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#04101A" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#38BDF8" Offset="0" />
                  <GradientStop Color="#22D3EE" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Opacity" Value="0.92" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bg" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Secondary Ghost Dark Button -->
    <Style x:Key="GhostBtn" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="#131B2B" BorderBrush="#263248" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#1B263B" />
                <Setter TargetName="bg" Property="BorderBrush" Value="#38BDF8" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bg" Property="Opacity" Value="0.38" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Danger Button for Uninstall -->
    <Style x:Key="DangerBtn" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="22,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="#E11D48" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#F43F5E" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bg" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dark TextBox -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#0A0E17" />
      <Setter Property="Foreground" Value="#F1F5F9" />
      <Setter Property="CaretBrush" Value="#38BDF8" />
      <Setter Property="BorderBrush" Value="#253248" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
              <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Modern Switch Toggle -->
    <Style x:Key="ModernSwitch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Border x:Name="Track" Grid.Column="1" Width="38" Height="20" CornerRadius="10" Background="#253044" VerticalAlignment="Center">
                <Grid>
                  <Border x:Name="Knob" Width="14" Height="14" CornerRadius="7" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0" />
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#38BDF8" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Preset Card Button -->
    <Style x:Key="PresetCardBtn" TargetType="Button">
      <Setter Property="Height" Value="56" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="card" Property="Opacity" Value="0.94" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#1C273B" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left Brand & Stepper Sidebar -->
      <Border Grid.Column="0" BorderBrush="#172033" BorderThickness="0,0,1,0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0D1322" Offset="0" />
            <GradientStop Color="#07090F" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="22,26,20,22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Brand Header -->
          <StackPanel Grid.Row="0">
            <Border Width="60" Height="60" CornerRadius="15" HorizontalAlignment="Left" Background="#0F172A" BorderBrush="#263956" BorderThickness="1" Margin="0,0,0,14">
              <Image x:Name="BrandIconImage" Width="52" Height="52" Stretch="Uniform" />
            </Border>
            <TextBlock Text="AETHER" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" />
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
              <Border Background="#122B3F" BorderBrush="#255D7D" BorderThickness="1" CornerRadius="6" Padding="7,2">
                <TextBlock x:Name="TxtSidebarVersion" Text="v2.2.0 · x64" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" />
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- 4-Step Vertical Stepper -->
          <StackPanel x:Name="StepperPanel" Grid.Row="1" Margin="0,34,0,0">
            <!-- Step 0 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <Border x:Name="StepBadge0" Width="26" Height="26" CornerRadius="13" Background="#38BDF8">
                <TextBlock x:Name="StepNum0" Text="1" FontSize="11.5" FontWeight="Bold" Foreground="#04101A" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock x:Name="StepLabel0" Text="환영 및 환경 점검" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="11,0,0,0" />
            </StackPanel>
            <!-- Step 1 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <Border x:Name="StepBadge1" Width="26" Height="26" CornerRadius="13" Background="#172033">
                <TextBlock x:Name="StepNum1" Text="2" FontSize="11.5" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock x:Name="StepLabel1" Text="설치 구성 및 옵션" FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="11,0,0,0" />
            </StackPanel>
            <!-- Step 2 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <Border x:Name="StepBadge2" Width="26" Height="26" CornerRadius="13" Background="#172033">
                <TextBlock x:Name="StepNum2" Text="3" FontSize="11.5" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock x:Name="StepLabel2" Text="설치 진행" FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="11,0,0,0" />
            </StackPanel>
            <!-- Step 3 -->
            <StackPanel Orientation="Horizontal">
              <Border x:Name="StepBadge3" Width="26" Height="26" CornerRadius="13" Background="#172033">
                <TextBlock x:Name="StepNum3" Text="4" FontSize="11.5" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock x:Name="StepLabel3" Text="설치 완료" FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="11,0,0,0" />
            </StackPanel>
          </StackPanel>

          <!-- Sidebar Footer -->
          <StackPanel Grid.Row="2">
            <TextBlock Text="Windows 10 / 11 Native" FontSize="11" Foreground="#64748B" />
            <TextBlock Text="Obsidian PIP Media Studio" FontSize="11" Foreground="#475569" Margin="0,2,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Right Content Area -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="46" />
          <RowDefinition Height="*" />
          <RowDefinition Height="66" />
        </Grid.RowDefinitions>

        <!-- Draggable Window Top Bar -->
        <Grid x:Name="DragHeader" Grid.Row="0" Background="Transparent">
          <TextBlock x:Name="TxtHeaderSub" Text="STEP 1 OF 4 · WELCOME" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="28,0,0,0" />
          <Button x:Name="BtnCloseX" Content="✕" Width="38" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" Cursor="Hand" />
        </Grid>

        <!-- Page Host -->
        <Grid Grid.Row="1" Margin="28,4,28,8">

          <!-- PAGE 0: Welcome & System Check -->
          <StackPanel x:Name="PageWelcome" Visibility="Visible">
            <TextBlock x:Name="TxtWelcomeTitle" Text="AETHER Player v2.2.0 설치" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
            <TextBlock x:Name="TxtWelcomeDesc" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="#94A3B8" Margin="0,8,0,18"
                       Text="MP4, WebM, MKV, MP3 및 다운로드 중인 .part 파일까지 재생하는 Windows 네이티브 PIP 미디어 스튜디오를 설치합니다." />

            <!-- 3 Feature Highlights -->
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Background="#0D1321" BorderBrush="#1B263B" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel>
                  <TextBlock Text="플로팅 PIP 엔진" FontSize="12.5" FontWeight="SemiBold" Foreground="#38BDF8" />
                  <TextBlock Text="투명도 · 모서리 스냅 · 고스트 클릭통과 · 비율 자동맞춤" TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#0D1321" BorderBrush="#1B263B" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel>
                  <TextBlock Text="올인원 포맷 지원" FontSize="12.5" FontWeight="SemiBold" Foreground="#34D399" />
                  <TextBlock Text="MP4 · WebM · MKV · MP3 · .part · SRT/VTT · LRC 가사" TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Background="#0D1321" BorderBrush="#1B263B" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel>
                  <TextBlock Text="스마트 자동 업데이트" FontSize="12.5" FontWeight="SemiBold" Foreground="#A78BFA" />
                  <TextBlock Text="GitHub / JSON 피드 연동 원클릭 무중단 업그레이드" TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- System Check Box -->
            <Border Background="#0B101B" BorderBrush="#1C273B" BorderThickness="1" CornerRadius="12" Padding="14,12">
              <StackPanel>
                <TextBlock Text="실시간 시스템 환경 점검" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,9" />
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="운영체제 아키텍처" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                  <TextBlock x:Name="TxtCheckOs" Grid.Row="0" Grid.Column="1" Text="Windows 64-bit 확인됨 ✓" FontSize="12" Foreground="#34D399" VerticalAlignment="Center" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="WebView2 런타임" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                  <TextBlock x:Name="TxtCheckWv2" Grid.Row="1" Grid.Column="1" Text="확인 중..." FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="설치 유형" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                  <TextBlock x:Name="TxtCheckMode" Grid.Row="2" Grid.Column="1" Text="신규 설치 준비 완료" FontSize="12" Foreground="#E2E8F0" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- PAGE 1: Install Configuration & Options -->
          <StackPanel x:Name="PageOptions" Visibility="Collapsed">
            <TextBlock Text="설치 구성 및 경로 선택" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />

            <!-- Preset Cards -->
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="BtnPresetStandard" Grid.Column="0" Style="{StaticResource PresetCardBtn}" Background="#112438" BorderBrush="#38BDF8" BorderThickness="1.5">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="TxtPresetStandardTitle" Text="표준 설치 (추천)" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" />
                  <TextBlock Text="바로가기 + 기본 프로그램 등록" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>
              </Button>
              <Button x:Name="BtnPresetCustom" Grid.Column="2" Style="{StaticResource PresetCardBtn}" Background="#0D1321" BorderBrush="#1E293B" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="TxtPresetCustomTitle" Text="최소 설치" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" />
                  <TextBlock Text="바로가기 · 파일 연결 없이 깔끔하게" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>
              </Button>
            </Grid>

            <!-- Install Path -->
            <Grid Margin="0,0,0,4">
              <TextBlock Text="설치 폴더" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Left" />
              <TextBlock x:Name="TxtDiskSpace" Text="필요 공간 ~2.5 MB" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TxtInstallPath" Grid.Column="0" Style="{StaticResource DarkTextBox}" />
              <Button x:Name="BtnBrowse" Grid.Column="2" Content="찾아보기" Height="36" Style="{StaticResource GhostBtn}" Padding="14,0" />
            </Grid>

            <!-- Modern Toggle Switches -->
            <Border Background="#0C111D" BorderBrush="#1A2538" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
              <StackPanel>
                <CheckBox x:Name="ToggleDesktop" Style="{StaticResource ModernSwitch}" IsChecked="True" Content="바탕 화면에 AETHER Player 바로가기 만들기" Margin="0,0,0,10" />
                <CheckBox x:Name="ToggleStartMenu" Style="{StaticResource ModernSwitch}" IsChecked="True" Content="시작 메뉴 프로그램 목록에 추가 (제거 도구 포함)" Margin="0,0,0,10" />
                <CheckBox x:Name="ToggleAssoc" Style="{StaticResource ModernSwitch}" IsChecked="True" Content="MP4 · WebM · MKV · MP3 · .part 기본 미디어 프로그램으로 등록" />
              </StackPanel>
            </Border>

            <!-- Built-in Auto-Update Engine Info -->
            <Border Background="#0B101B" BorderBrush="#1A2538" BorderThickness="1" CornerRadius="10" Padding="12,9">
              <TextBlock Text="자동 업데이트 엔진 내장 · 새 버전 출시 시 앱에서 원클릭으로 업그레이드할 수 있습니다." FontSize="11.5" Foreground="#94A3B8" />
            </Border>
          </StackPanel>

          <!-- PAGE 2: Installation Progress & Live Log -->
          <StackPanel x:Name="PageProgress" Visibility="Collapsed">
            <TextBlock Text="AETHER Player 설치 중" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,10">
              <TextBlock x:Name="TxtProgressStatus" Text="설치 준비 중..." FontSize="13" Foreground="#CBD5E1" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <TextBlock x:Name="TxtProgressPct" Text="0%" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- Custom Glowing Progress Bar -->
            <Border x:Name="ProgressTrack" Height="10" Background="#121A2A" CornerRadius="5" Margin="0,0,0,18">
              <Border x:Name="ProgressFill" Width="0" Height="10" HorizontalAlignment="Left" CornerRadius="5">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#38BDF8" Offset="0" />
                    <GradientStop Color="#22D3EE" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Border>

            <TextBlock Text="설치 로그" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,6" />
            <Border Background="#090D16" BorderBrush="#1A2538" BorderThickness="1" CornerRadius="11" Height="238" Padding="10">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtInstallLog" FontFamily="Consolas, Cascadia Code" FontSize="11.5" LineHeight="18" Foreground="#94A3B8" TextWrapping="Wrap" />
              </ScrollViewer>
            </Border>
          </StackPanel>

          <!-- PAGE 3: Finish & Quick PIP Guide -->
          <StackPanel x:Name="PageFinish" Visibility="Collapsed">
            <Border Width="42" Height="42" CornerRadius="21" Background="#0F2D28" BorderBrush="#34D399" BorderThickness="1.5" HorizontalAlignment="Left" Margin="0,0,0,8">
              <TextBlock Text="✓" FontSize="20" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TxtFinishTitle" Text="설치가 성공적으로 완료되었습니다!" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" />
            <TextBlock x:Name="TxtFinishPath" Text="" FontSize="11.5" Foreground="#94A3B8" Margin="0,3,0,10" TextTrimming="CharacterEllipsis" />

            <Border Background="#0C1220" BorderBrush="#1D2A42" BorderThickness="1" CornerRadius="11" Padding="12,9" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="핵심 PIP 단축키 빠른 안내" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,5" />
                <TextBlock Text="• P : 데스크톱 플로팅 PIP 모드  |  Alt + Shift + P : 전역 PIP 토글" FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,3" />
                <TextBlock Text="• Alt + Shift + G : 고스트 모드 (PIP 클릭 통과)  |  상단 끝 드래그 : 전체화면" FontSize="11.5" Foreground="#CBD5E1" />
              </StackPanel>
            </Border>

            <Border x:Name="AssocFinishCard" Background="#102136" BorderBrush="#2A5E82" BorderThickness="1" CornerRadius="11" Padding="12,8" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock x:Name="TxtAssocFinishHint" Text="Windows 11에서는 열린 설정 화면 상단의 [기본값 설정] 버튼을 1번 눌러야 최종 전환됩니다." TextWrapping="Wrap" FontSize="11.5" Foreground="#CBD5E1" />
                <CheckBox x:Name="ToggleOpenDefaultApps" Style="{StaticResource ModernSwitch}" IsChecked="True" Margin="0,6,0,0" Content="완료 시 Windows [기본 앱 → AETHER Player] 열기 (1클릭 적용)" />
              </StackPanel>
            </Border>

            <Border Background="#0C111D" BorderBrush="#1A2538" BorderThickness="1" CornerRadius="11" Padding="12,8" Margin="0,0,0,9">
              <CheckBox x:Name="ToggleLaunchAfter" Style="{StaticResource ModernSwitch}" IsChecked="True" Content="설치 창을 닫고 지금 AETHER Player 실행" />
            </Border>

            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnOpenDefaultApps" Content="Windows 기본 앱 설정 열기" Style="{StaticResource GhostBtn}" Height="32" Padding="14,0" FontSize="12" Margin="0,0,8,0" />
              <Button x:Name="BtnOpenInstallDir" Content="설치된 폴더 열기" Style="{StaticResource GhostBtn}" Height="32" Padding="14,0" FontSize="12" />
            </StackPanel>
          </StackPanel>

          <!-- UNINSTALL PAGE (Shown only in uninstall mode) -->
          <StackPanel x:Name="PageUninstall" Visibility="Collapsed">
            <TextBlock Text="AETHER Player 제거" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
            <TextBlock x:Name="TxtUninstallPath" Text="" FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,16" />

            <Border Background="#0C111D" BorderBrush="#1A2538" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,16">
              <CheckBox x:Name="ToggleRemoveUserData" Style="{StaticResource ModernSwitch}" IsChecked="False" Content="이어보기 기록, 북마크 및 업데이트 설정도 모두 삭제" />
            </Border>

            <Border Height="8" Background="#121A2A" CornerRadius="4" Margin="0,0,0,12">
              <Border x:Name="UninstallProgressFill" Width="0" Height="8" HorizontalAlignment="Left" Background="#F43F5E" CornerRadius="4" />
            </Border>

            <Border Background="#090D16" BorderBrush="#1A2538" BorderThickness="1" CornerRadius="11" Height="175" Padding="10">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtUninstallLog" FontFamily="Consolas, Cascadia Code" FontSize="11.5" LineHeight="18" Foreground="#94A3B8" TextWrapping="Wrap" />
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Bottom Footer Buttons -->
        <Border Grid.Row="2" BorderBrush="#141C2D" BorderThickness="0,1,0,0" Padding="28,0">
          <Grid VerticalAlignment="Center">
            <Button x:Name="BtnBack" Content="← 이전" Style="{StaticResource GhostBtn}" HorizontalAlignment="Left" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BtnCancel" Content="취소" Style="{StaticResource GhostBtn}" Margin="0,0,10,0" />
              <Button x:Name="BtnNext" Content="다음 →" Style="{StaticResource PrimaryBtn}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
